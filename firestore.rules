rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasCommunityRole(role) {
      return signedIn() &&
        exists(/databases/$(database)/documents/community_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/community_roles/$(request.auth.uid)).data.role == role;
    }

    function isModerator() {
      return hasCommunityRole('moderator') || hasCommunityRole('admin');
    }

    function isAdmin() {
      return hasCommunityRole('admin');
    }

    // ---------------------------------------------------------------------
    // MeiLists
    // ---------------------------------------------------------------------

    match /categories/{categoryId} {
      allow get: if request.auth != null;

      allow list: if request.auth != null &&
        (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid in resource.data.allowedUsers
        );

      allow create: if request.auth != null;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.allowedUsers ||
        (
          request.resource.data.allowedUsers.hasAll(resource.data.allowedUsers) &&
          request.auth.uid in request.resource.data.allowedUsers
        ) ||
        (
          resource.data.allowedUsers.hasAll(request.resource.data.allowedUsers) &&
          !(request.auth.uid in request.resource.data.allowedUsers)
        )
      );

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
    }

    match /shopping_lists/{listId} {
      allow read, write: if request.auth != null;
    }

    match /list_items/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /catalog_areas/{areaId} {
      allow read, write: if request.auth != null;
    }

    match /catalog_products/{productId} {
      allow read, write: if request.auth != null;
    }

    // ---------------------------------------------------------------------
    // MeiOCRWorkout Community
    // ---------------------------------------------------------------------

    // Small account directory used only so an admin can resolve a moderator
    // email address to the Firebase UID. Every user may maintain only their
    // own entry and the email must match the authenticated Firebase account.
    match /community_users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.emailNormalized == request.auth.token.email;

      allow delete: if false;
    }

    // Roles are stored by Firebase UID. The initial admin document is created
    // once manually in the Firebase console. Afterwards only the admin may
    // grant/revoke moderator access; the app cannot create another admin.
    match /community_roles/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create, update: if isAdmin() &&
        userId != request.auth.uid &&
        request.resource.data.role == 'moderator';

      allow delete: if isAdmin() &&
        userId != request.auth.uid;
    }

    // Approved profiles are public. Only moderators/admins may publish them.
    match /published_profiles/{profileId} {
      allow read: if true;
      allow create, update: if isModerator();
      allow delete: if isAdmin();
    }

    match /profile_submissions/{submissionId} {
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow read: if signedIn() &&
        (
          resource.data.ownerUid == request.auth.uid ||
          isModerator()
        );

      allow update: if isModerator() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedBy',
          'moderatorNote'
        ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
