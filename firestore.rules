rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return signedIn() &&
        (request.auth.token.role == 'moderator' || request.auth.token.role == 'admin');
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    match /published_profiles/{profileId} {
      allow read: if true;
      allow write: if false;
    }

    match /profile_submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isModerator());

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
